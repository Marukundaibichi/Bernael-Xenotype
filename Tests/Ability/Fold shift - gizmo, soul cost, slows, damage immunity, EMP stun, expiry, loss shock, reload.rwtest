rwtest 1
test "Fold shift - toggle, soul drain, slows, damage immunity, EMP stun, exhaustion, loss shock, reload" project="Bernael" created=2026-11-01T00:00:00

requires mod=Mortis.BX
requires dlc=Biotech
steppause ticks=1

spawn Pawn:Colonist at 0,0 name="Folder" xenotype=BX_Bernael
spawn Pawn:Colonist at 2,0 name="Poor" xenotype=BX_Bernael
spawn Pawn:Colonist at 4,0 name="Plain"
give "Folder" resource=BX_SoulEater value=0.9
give "Poor" resource=BX_SoulEater value=0.01

assert pawn "Folder" gene=BX_FoldSeverance expect=present
assert pawn "Plain" gene=BX_FoldSeverance expect=absent

select "Plain"
gizmo "Fold shift" expect=absent

draft "Poor"
select "Poor"
gizmo "Fold shift" expect=disabled reason="Poor does not have enough soul saturation." match=equals

assert pawn "Folder" stat=MoveSpeed min=3 expect=present
draft "Folder"
select "Folder"
gizmo "Fold shift" expect=allowed
tick 60 note="cast block: warmup 0.25 s is 15 ticks, the rest covers the job start"
assert pawn "Folder" hediff=BX_FoldShift_Hediff expect=present
assert pawn "Folder" resource=BX_SoulEater min=0.86 max=0.90 expect=present
assert pawn "Folder" stat=MoveSpeed max=1.2 expect=present
gizmo "Fold shift" expect=disabled
deselect
ask "fold-shift-look" claim="Folder darkens under an opaque black filter with a crimson outline and glowing eyes; its body, wings and clothing remain recognizable in dark tones, while Poor and Plain stay ordinary"

tick 250 note="toggle block: the active ability keeps draining 2% soul per second while sufficient soul remains"
assert pawn "Folder" hediff=BX_FoldShift_Hediff expect=present

damage "Folder" amount=20 kind=Cut
damage "Folder" amount=20 kind=Blunt
assert pawn "Folder" hediff=Cut expect=absent
assert pawn "Folder" hediff=Bruise expect=absent
assert pawn "Folder" hediff=BX_FoldShift_Hediff expect=present
assert pawn "Folder" hediff=XenogermLossShock expect=absent

damage "Folder" amount=5 kind=EMP
assert stun "Folder" ticks min=1400 max=1500 expect=present
assert pawn "Folder" hediff=BX_FoldShift_Hediff expect=absent
assert pawn "Folder" hediff=XenogermLossShock expect=present

damage "Plain" amount=10 kind=Cut
assert pawn "Plain" hediff=Cut expect=present
assert log clean

spawn Pawn:Colonist at 0,6 name="Saver" xenotype=BX_Bernael
give "Saver" resource=BX_SoulEater value=0.9
draft "Saver"
select "Saver"
gizmo "Fold shift" expect=allowed
tick 60 note="reload block: the cast lands as in the cast block"
assert pawn "Saver" hediff=BX_FoldShift_Hediff expect=present
reload note="reload block: the hediff and its remaining time are scribed"
assert pawn "Saver" hediff=BX_FoldShift_Hediff expect=present
assert pawn "Saver" stat=MoveSpeed max=1.2 expect=present
select "Saver"
gizmo "Rancor of Souls" expect=disabled
damage "Saver" amount=20 kind=Cut
assert pawn "Saver" hediff=Cut expect=absent
tick 700 note="sustained toggle: the effect remains active while its soul payments can be made"
assert pawn "Saver" hediff=BX_FoldShift_Hediff expect=present
assert pawn "Saver" hediff=XenogermLossShock expect=absent
give "Saver" resource=BX_SoulEater value=0.01
tick 60 note="exhaustion: the next per-second payment cannot be made, so the toggle shuts down"
assert pawn "Saver" hediff=BX_FoldShift_Hediff expect=absent
assert pawn "Saver" hediff=XenogermLossShock expect=present
assert log clean

requires assert=pathcost
sky glow=1
terrain Mud at 1,12
terrain Soil at -1,12
terrain Mud at 1,14
terrain Soil at -1,14
spawn Pawn:Colonist at 0,12 name="Wader" xenotype=BX_Bernael age=30
spawn Pawn:Colonist at 0,14 name="Walker" xenotype=BX_Bernael age=30
gene "Walker" remove=UVSensitivity_Mild
gene "Wader" remove=UVSensitivity_Mild
give "Walker" hediff=BX_WitheredSoulHediff severity=1 hold=on
give "Wader" hediff=BX_WitheredSoulHediff severity=1 hold=on
assert pawn "Walker" stat=MoveSpeed min=4.5 max=4.7 expect=present
draft "Walker"
give "Wader" resource=BX_SoulEater value=0.9
draft "Wader"
select "Wader"
gizmo "Fold shift" expect=allowed
tick 60 note="path cost block: the cast lands as in the cast block"
assert pawn "Wader" hediff=BX_FoldShift_Hediff expect=present
assert pathcost "Walker" at -1,14 min=13 max=17
assert pathcost "Walker" at 1,14 min=25 max=29
assert pathcost "Wader" at -1,12 min=60 max=70
assert pathcost "Wader" at 1,12 min=60 max=70
reload note="terrain-cost exemption survives saving an active shift"
assert pathcost "Wader" at -1,12 min=60 max=70
assert pathcost "Wader" at 1,12 min=60 max=70
assert log clean
