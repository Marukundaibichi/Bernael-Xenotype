    </shaderProgram>
  </ShaderDef>
  <!-- After the sun shadows (3170) and their fading edges (3175), whose straight-edged wall shadows otherwise cut
       across the pale fog; still under the darkness overlay (3180). Gates are only drawn on unfogged cells. -->
  <ShaderDef>
